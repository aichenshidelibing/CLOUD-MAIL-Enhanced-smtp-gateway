{
  "listen": {
    "host": "0.0.0.0",
    "port": 2525,
    "containerHost": "0.0.0.0",
    "containerPort": 2525
  },
  "smtp": {
    "user": "my-app",
    "password": "replace-with-cloud-mail-smtp-api-key",
    "maxMessageSize": 10485760,
    "tls": {
      "enabled": true,
      "required": true,
      "certFile": "/app/tls/server.crt",
      "keyFile": "/app/tls/server.key",
      "minVersion": "TLSv1.2"
    }
  },
  "upstream": {
    "url": "https://mail.example.com/api/smtp/send",
    "healthUrl": "https://mail.example.com/api/smtp/health",
    "user": "my-app",
    "apiKey": "replace-with-cloud-mail-smtp-api-key",
    "timeoutMs": 15000
  }
}
